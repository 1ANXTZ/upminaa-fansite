/*
=====================================
UPMINAA FAN HUB
MAIN STYLESHEET
=====================================
*/


/* ================================
RESET
================================ */


* {

margin:0;
padding:0;
box-sizing:border-box;

}



html {

scroll-behavior:smooth;

}



body {

font-family:
"Inter",
Arial,
sans-serif;

background:#0d0d14;

color:#ffffff;

line-height:1.6;

overflow-x:hidden;

}



img {

max-width:100%;

display:block;

}



a {

text-decoration:none;

color:inherit;

}



.container {

width:min(1200px,90%);

margin:auto;

}







/* ================================
COLORS
================================ */


:root {


--bg-main:#0d0d14;

--bg-card:#171722;

--bg-soft:#202033;


--primary:#ff7ac8;

--secondary:#8b7cff;


--text:#ffffff;

--muted:#b8b8c7;


--border:
rgba(255,255,255,.08);


}





/* ================================
SECTION DEFAULT
================================ */


section {

padding:100px 0;

}



.section-title {

text-align:center;

margin-bottom:50px;

}



.section-title span {

color:var(--primary);

font-size:.9rem;

text-transform:uppercase;

letter-spacing:3px;

}



.section-title h2 {

font-size:2.5rem;

margin-top:10px;

}



.section-title p {

color:var(--muted);

max-width:700px;

margin:15px auto;

}







/* ================================
NAVBAR
================================ */


.site-header {

position:fixed;

top:0;

left:0;

width:100%;

z-index:1000;


background:
rgba(13,13,20,.85);


backdrop-filter:blur(12px);


border-bottom:
1px solid var(--border);


}



.navbar {

height:80px;

width:min(1200px,90%);

margin:auto;


display:flex;

align-items:center;

justify-content:space-between;


}



.logo {

font-size:1.4rem;

font-weight:800;

color:var(--primary);

}



.nav-links {

display:flex;

gap:30px;

list-style:none;

}



.nav-links a {


color:var(--muted);

transition:.3s;

}



.nav-links a:hover {


color:white;

}







/* ================================
HERO
================================ */


.hero {

padding-top:150px;

min-height:100vh;


display:flex;

align-items:center;


}



.hero-content {


width:min(1200px,90%);

margin:auto;


display:grid;

grid-template-columns:1fr 1fr;

gap:50px;

align-items:center;


}



.hero-tag {


color:var(--primary);

font-weight:700;

letter-spacing:2px;

font-size:.8rem;


}



.hero h1 {


font-size:4rem;

line-height:1.1;

margin:20px 0;


}



.hero p {


color:var(--muted);

font-size:1.15rem;

max-width:550px;


}



.hero-buttons {


display:flex;

gap:20px;

margin-top:35px;


}



.primary-btn,
.secondary-btn {


padding:14px 30px;

border-radius:30px;

font-weight:700;

transition:.3s;


}



.primary-btn {


background:var(--primary);

color:#111;


}



.secondary-btn {


border:1px solid var(--border);

background:var(--bg-card);


}



.primary-btn:hover,
.secondary-btn:hover {


transform:translateY(-3px);

}







.hero-image img {


width:100%;

height:500px;

object-fit:cover;


border-radius:25px;


box-shadow:
0 20px 60px rgba(0,0,0,.4);


}







/* ================================
ABOUT
================================ */


.about-container {


width:min(1200px,90%);

margin:auto;


display:grid;

grid-template-columns:400px 1fr;

gap:60px;

align-items:center;


}



.about-image img {


height:500px;

width:100%;

object-fit:cover;


border-radius:25px;


}





.info-cards {


display:grid;

grid-template-columns:repeat(2,1fr);

gap:20px;


}



.fact-card {


background:var(--bg-card);

border:1px solid var(--border);


padding:25px;

border-radius:18px;


}



.fact-card h3 {


font-size:1rem;

color:var(--primary);

margin-bottom:8px;


}



.fact-card p {


color:var(--muted);

}






.about-description {


margin-top:30px;


}



.about-description p {


color:var(--muted);

margin-bottom:18px;


}/* ================================
COSPLAYS
================================ */


.cosplays-section {

width:100%;

}




/* FEATURED */

.featured-cosplays {


width:min(1200px,90%);

margin:auto;


display:grid;

grid-template-columns:repeat(2,1fr);

gap:30px;


}



.cosplay-card {


background:var(--bg-card);

border:
1px solid var(--border);


border-radius:22px;


overflow:hidden;


transition:.35s;


}



.cosplay-card:hover {


transform:translateY(-8px);


}





.cosplay-link {


display:block;

overflow:hidden;


}




.cosplay-card img {


width:100%;


height:100%;


object-fit:cover;


transition:.5s;


}



.cosplay-card:hover img {


transform:scale(1.05);


}






/* FEATURED SIZE */


.featured-card {


height:560px;


position:relative;


}



.featured-card .cosplay-link {


height:100%;


}



.featured-card img {


height:100%;


}





.featured-card::after {


content:"";

position:absolute;

inset:0;


background:
linear-gradient(
transparent 40%,
rgba(0,0,0,.8)
);


pointer-events:none;


}





.cosplay-info {


padding:25px;


position:relative;

z-index:2;


}



.featured-card .cosplay-info {


position:absolute;

bottom:0;

left:0;

width:100%;


}



.cosplay-label {


display:inline-block;


background:var(--primary);

color:#111;


padding:6px 15px;


border-radius:20px;


font-size:.75rem;


font-weight:800;


margin-bottom:12px;


}





.cosplay-info h3 {


font-size:1.8rem;


}



.cosplay-info p {


color:var(--muted);


}






.source-box {


margin-top:15px;


font-size:.85rem;


color:var(--muted);


}



.source-box a {


color:var(--primary);


}









/* ================================
POPULAR GRID 2X2
================================ */



.popular-cosplays {


width:min(1200px,90%);

margin:40px auto 0;


display:grid;


grid-template-columns:
repeat(2,1fr);


gap:25px;


}







.popular-cosplays .cosplay-card {


height:320px;


}




.popular-cosplays .cosplay-link {


height:220px;


}



.popular-cosplays img {


height:220px;


}




.popular-cosplays .cosplay-info {


padding:20px;


}



.popular-cosplays .cosplay-info h3 {


font-size:1.35rem;


}




.popular-cosplays .source-box {


display:none;


}









/* ================================
IMAGE POSITION CONTROL
================================ */


/*
 Ajustes individuais para evitar
 cortes ruins nas fotos
*/


.cosplay-gura img {

object-position:center;

}



.cosplay-miku-br img {

object-position:center;

}



.cosplay-marin img {

object-position:center top;

}



.cosplay-frieren img {

object-position:center top;

}



.cosplay-nino img {

object-position:center;

}



.cosplay-miku-nakano img {

object-position:center;

}/* ================================
GALLERY
================================ */


.gallery-section {


width:100%;


}



.gallery-grid {


width:min(1200px,90%);

margin:auto;


display:grid;


grid-template-columns:
repeat(2,1fr);


gap:30px;


}






.gallery-item {


background:var(--bg-card);


border:
1px solid var(--border);


border-radius:22px;


overflow:hidden;


transition:.35s;


}




.gallery-item:hover {


transform:translateY(-6px);


}






.gallery-link {


display:block;


height:350px;


overflow:hidden;


}





.gallery-link img {


width:100%;


height:100%;


object-fit:cover;


transition:.5s;


}




.gallery-item:hover img {


transform:scale(1.06);


}






.gallery-info {


padding:25px;


}





.gallery-info h3 {


font-size:1.4rem;


margin-bottom:10px;


}



.gallery-info p {


color:var(--muted);


}









/* ================================
LIGHTBOX
================================ */



.lightbox {


position:fixed;


inset:0;


background:
rgba(0,0,0,.9);


display:flex;


align-items:center;


justify-content:center;


padding:40px;


opacity:0;


visibility:hidden;


transition:.3s;


z-index:2000;


}





.lightbox.active {


opacity:1;


visibility:visible;


}




.lightbox img {


max-width:90%;


max-height:85vh;


object-fit:contain;


border-radius:20px;


box-shadow:
0 20px 60px rgba(0,0,0,.5);


}







.lightbox-close {


position:absolute;


top:30px;


right:40px;


background:none;


border:none;


color:white;


font-size:3rem;


cursor:pointer;


}







/* ================================
REFERENCES
================================ */


.references-section {


width:min(1200px,90%);


margin:70px auto 0;


background:var(--bg-card);


padding:35px;


border-radius:25px;


border:
1px solid var(--border);


}





.reference-cards {


display:grid;


grid-template-columns:
repeat(2,1fr);


gap:25px;


margin-top:30px;


}





.reference-card {


background:var(--bg-soft);


padding:25px;


border-radius:18px;


}



.reference-card h4 {


color:var(--primary);


margin-bottom:10px;


}



.reference-card p {


color:var(--muted);


margin-bottom:15px;


}



.reference-card a {


color:var(--primary);


font-weight:700;


}/* ================================
MEDIA SECTION
================================ */


.media-section {

width:100%;

}





.media-group {


width:min(1200px,90%);


margin:

0 auto 70px;


}



.media-title {


font-size:1.8rem;


margin-bottom:30px;


color:white;


}






/* ================================
TWITCH
================================ */



.twitch-grid {


display:grid;


grid-template-columns:
repeat(2,1fr);


gap:35px;


}





.live-player-card {


background:var(--bg-card);


border:
1px solid var(--border);


border-radius:22px;


overflow:hidden;


transition:.3s;


}





.live-player-card:hover {


transform:translateY(-5px);


}





.player-wrapper {


width:100%;


background:#000;


aspect-ratio:
16 / 9;


}





.player-wrapper iframe {


width:100%;


height:100%;


border:0;


}







.player-info {


padding:25px;


}





.player-info h4 {


font-size:1.4rem;


margin-bottom:10px;


}




.player-info p {


color:var(--muted);


margin-bottom:20px;


}





.player-info a {


display:inline-block;


padding:10px 22px;


border-radius:25px;


background:var(--primary);


color:#111;


font-weight:700;


}









/* ================================
YOUTUBE
================================ */





.youtube-grid {


display:grid;


grid-template-columns:
repeat(2,1fr);


gap:35px;


}





.youtube-card {


background:var(--bg-card);


border:
1px solid var(--border);


border-radius:22px;


overflow:hidden;


transition:.3s;


}




.youtube-card:hover {


transform:translateY(-5px);


}





.video-info {


padding:25px;


}





.video-info h4 {


font-size:1.4rem;


margin-bottom:10px;


}





.video-info p {


color:var(--muted);


margin-bottom:20px;


}





.video-info a {


color:var(--primary);


font-weight:700;


}








/* ================================
MEDIA MOBILE
================================ */



@media(max-width:900px){


.twitch-grid,
.youtube-grid {


grid-template-columns:1fr;


}



}/* ================================
COMMUNITY SECTION
================================ */


.community-section {


width:100%;


}





.social-grid {


width:min(1200px,90%);


margin:auto;


display:grid;


grid-template-columns:
repeat(3,1fr);


gap:30px;


}





.social-card {


background:var(--bg-card);


border:

1px solid var(--border);


border-radius:22px;


padding:30px;


display:flex;


flex-direction:column;


gap:20px;


transition:.3s;


}




.social-card:hover {


transform:translateY(-8px);


}






.social-icon {


width:60px;


height:60px;


border-radius:18px;


display:flex;


align-items:center;


justify-content:center;


font-size:2rem;


font-weight:800;


color:white;


}






.social-info h3 {


font-size:1.5rem;


margin-bottom:8px;


}





.social-info p {


color:var(--muted);


margin-bottom:20px;


}





.social-info a {


display:inline-flex;


align-items:center;


justify-content:center;


padding:12px 25px;


border-radius:30px;


font-weight:700;


transition:.3s;


}






.social-info a:hover {


transform:translateY(-3px);


}









/* ================================
PLATFORM COLORS
================================ */





/* Instagram */


.instagram .social-icon {


background:

linear-gradient(
135deg,
#feda75,
#d62976,
#962fbf
);


}



.instagram .social-info a {


background:#d62976;


color:white;


}








/* TikTok */


.tiktok .social-icon {


background:#000;


border:1px solid white;


}



.tiktok .social-info a {


background:#000;


border:1px solid white;


color:white;


}








/* Twitch */


.twitch .social-icon {


background:#9146ff;


}



.twitch .social-info a {


background:#9146ff;


color:white;


}








/* YouTube */


.youtube .social-icon {


background:#ff0000;


}



.youtube .social-info a {


background:#ff0000;


color:white;


}








/* X */


.twitter .social-icon {


background:#050505;


border:1px solid #333;


}



.twitter .social-info a {


background:#050505;


border:1px solid #333;


color:white;


}








/* ================================
REFERENCES
================================ */





.references-section {


margin-top:80px;


}



.references-section h3 {


font-size:1.8rem;


margin-bottom:15px;


}





.references-section > p {


color:var(--muted);


}




.reference-cards {


display:grid;


grid-template-columns:
repeat(2,1fr);


gap:25px;


margin-top:30px;


}







.reference-card {


background:var(--bg-soft);


padding:25px;


border-radius:18px;


border:

1px solid var(--border);


}




.reference-card a {


color:var(--primary);


font-weight:700;


}









/* ================================
SOCIAL RESPONSIVE
================================ */


@media(max-width:1000px){


.social-grid {


grid-template-columns:
repeat(2,1fr);


}



}




@media(max-width:650px){


.social-grid {


grid-template-columns:1fr;


}



.reference-cards {


grid-template-columns:1fr;


}



}/* ================================
FOOTER
================================ */


.site-footer {


padding:50px 20px;


background:#080810;


border-top:

1px solid var(--border);


text-align:center;


}





.footer-content {


width:min(900px,90%);


margin:auto;


}





.footer-content h3 {


font-size:1.5rem;


color:var(--primary);


margin-bottom:15px;


}





.footer-content p {


color:var(--muted);


}





.copyright {


margin-top:20px;


font-size:.9rem;


}









/* ================================
BACK TO TOP
================================ */



.back-top {


position:fixed;


right:30px;


bottom:30px;


width:50px;


height:50px;


border-radius:50%;


background:var(--primary);


color:#111;


display:flex;


align-items:center;


justify-content:center;


font-size:1.5rem;


cursor:pointer;


opacity:0;


visibility:hidden;


transition:.3s;


z-index:999;


}





.back-top.show {


opacity:1;


visibility:visible;


}









/* ================================
NAVBAR MOBILE
================================ */





@media(max-width:900px){



.navbar {


height:auto;


padding:20px 0;


flex-direction:column;


gap:20px;


}



.nav-links {


gap:15px;


flex-wrap:wrap;


justify-content:center;


}




.hero-content {


grid-template-columns:1fr;


text-align:center;


}




.hero h1 {


font-size:3rem;


}



.hero p {


margin:auto;


}



.hero-buttons {


justify-content:center;


}




.hero-image img {


height:400px;


}





.about-container {


grid-template-columns:1fr;


}




.about-image img {


height:450px;


}





.featured-cosplays {


grid-template-columns:1fr;


}




.popular-cosplays {


grid-template-columns:1fr;


}




.gallery-grid {


grid-template-columns:1fr;


}





}/* ================================
ANIMATIONS
================================ */



.fact-card,
.cosplay-card,
.gallery-item,
.youtube-card,
.live-player-card,
.social-card {


opacity:0;


transform:
translateY(40px);


transition:

opacity .7s ease,
transform .7s ease;


}





.fact-card.visible,
.cosplay-card.visible,
.gallery-item.visible,
.youtube-card.visible,
.live-player-card.visible,
.social-card.visible {


opacity:1;


transform:

translateY(0);


}








/* ================================
CARD HOVER EFFECTS
================================ */



.fact-card:hover {


border-color:

rgba(255,122,200,.5);


}





.gallery-item:hover,
.cosplay-card:hover,
.live-player-card:hover,
.youtube-card:hover,
.social-card:hover {


border-color:

rgba(255,122,200,.4);


}








/* ================================
BUTTON ANIMATIONS
================================ */



.primary-btn,
.secondary-btn,
.social-info a,
.player-info a {


position:relative;


overflow:hidden;


}



.primary-btn::before,
.secondary-btn::before,
.social-info a::before,
.player-info a::before {


content:"";


position:absolute;


inset:0;


background:

rgba(255,255,255,.15);


transform:

translateX(-100%);


transition:.4s;


}





.primary-btn:hover::before,
.secondary-btn:hover::before,
.social-info a:hover::before,
.player-info a:hover::before {


transform:

translateX(0);


}









/* ================================
IMAGE SMOOTH EFFECT
================================ */



.hero-image img,
.about-image img,
.gallery-item img,
.cosplay-card img {


animation:

imageFade .8s ease;


}





@keyframes imageFade {


from {


opacity:0;


}



to {


opacity:1;


}



}









/* ================================
SCROLL OFFSET
================================ */



section {


scroll-margin-top:100px;


}









/* ================================
SOURCE BOX STYLE
================================ */



.source-box {


padding-top:10px;


}



.source-box strong {


color:white;


}




.source-box a:hover {


text-decoration:underline;


}









/* ================================
LIGHTBOX ANIMATION
================================ */



.lightbox.active img {


animation:

zoomIn .3s ease;


}





@keyframes zoomIn {


from {


transform:scale(.8);


opacity:0;


}



to {


transform:scale(1);


opacity:1;


}



}









/* ================================
TEXT SELECTION
================================ */



::selection {


background:var(--primary);


color:#111;


}/* ================================
FINAL IMAGE SETTINGS
================================ */



.hero-image img {


object-position:center;


}




.about-image img {


object-position:center;


}







/* ================================
COSPLAY IMAGE CONTROL
================================ */



.featured-card img {


object-fit:cover;


object-position:center;


}




.popular-cosplays img {


object-fit:cover;


object-position:center top;


}





/*
 Individual adjustments
 Caso alguma foto tenha corte ruim
*/


.cosplay-card:nth-child(1) img {


object-position:center;


}



.cosplay-card:nth-child(2) img {


object-position:center top;


}



.cosplay-card:nth-child(3) img {


object-position:center;


}



.cosplay-card:nth-child(4) img {


object-position:center;


}









/* ================================
GALLERY IMAGE CONTROL
================================ */



.gallery-item:nth-child(1) img {


object-position:center;


}



.gallery-item:nth-child(2) img {


object-position:center;


}



.gallery-item:nth-child(3) img {


object-position:center;


}



.gallery-item:nth-child(4) img {


object-position:center;


}









/* ================================
SPACING FINAL TOUCHES
================================ */



.cosplays-section,
.gallery-section,
.media-section,
.community-section {


overflow:hidden;


}





.media-group + .media-group {


margin-top:80px;


}





.community-section {


padding-bottom:120px;


}








/* ================================
SMALL DEVICES
================================ */



@media(max-width:600px){



section {


padding:70px 0;


}





.hero {


padding-top:120px;


}





.hero h1 {


font-size:2.4rem;


}





.hero-buttons {


flex-direction:column;


align-items:center;


}





.primary-btn,
.secondary-btn {


width:220px;


text-align:center;


}





.info-cards {


grid-template-columns:1fr;


}





.featured-card {


height:450px;


}





.popular-cosplays .cosplay-card {


height:auto;


}





.popular-cosplays .cosplay-link {


height:280px;


}





.gallery-link {


height:280px;


}





.lightbox {


padding:20px;


}



.lightbox img {


max-width:95%;


}



}
